{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "server/src/server.ts"
    },
    {
      "source": "/assets/:path*",
      "destination": "client/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "client/favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "client/icons.svg"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "client/index.html"
    }
  ]
}
